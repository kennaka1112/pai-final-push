<?xml version="1.0" ?>
<!-- 押しタスク用ワールド
     crane_plus_gazebo/worlds/table.sdf をベースに、
       * 押す対象のブロックを自前定義（色がはっきり出るように。Fuelモデル依存も減らす）
       * 開始位置と目標エリアのマーカーを追加
     座標はロボット基部(world: 0,0,1.015 = 机の天板)を基準に極座標で設計:
       ブロック初期位置 : 半径0.14m, 方位 -20deg
       目標エリア       : 半径0.14m, 方位 +23deg -->
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Ground%20Plane</uri>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Table</uri>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </include>

    <!-- 押す対象のブロック（4cm角・赤） -->
    <model name="target_block">
      <pose>0.1316 -0.0479 1.035 0 0 -0.3491</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>2.13e-5</ixx><iyy>2.13e-5</iyy><izz>2.13e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.55 0.07 0.07 1</ambient>
            <diffuse>0.85 0.12 0.12 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 目標エリア（見た目だけ。当たり判定なし） -->
    <model name="goal_zone">
      <static>true</static>
      <pose>0.1289 0.0547 1.0156 0 0 0.4014</pose>
      <link name="link">
        <visual name="pad">
          <geometry><box><size>0.085 0.085 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.45 0.12 1</ambient>
            <diffuse>0.10 0.80 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 開始位置の目印（見た目だけ） -->
    <model name="start_marker">
      <static>true</static>
      <pose>0.1316 -0.0479 1.0155 0 0 -0.3491</pose>
      <link name="link">
        <visual name="pad">
          <geometry><box><size>0.085 0.085 0.001</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.62 0.62 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
