#!/bin/bash
# 学習済み方策で1試行（1回の押し動作）だけ実行し、成否を判定する。
#   使い方: push-trial [制御秒数=15] [試行回数=1]
#   各試行の前にアームを直立へ戻し、ブロックを開始位置へ戻して条件をそろえる。
#   モデルの読み込みに時間がかかるため、方策が実際に指令を出し始めてから計測する。
source /opt/ros/humble/setup.bash
source ~/airobot_ws/install/setup.bash
export DISPLAY=:0
SEC="${1:-15}"
N="${2:-1}"
HERE="$(cd "$(dirname "$0")" && pwd)"
OK=0
SUM=0
for i in $(seq 1 "$N"); do
  pkill -f "scripts/infer.py" >/dev/null 2>&1 || true
  sleep 1
  python3 "$HERE/goto_upright.py" 4          # アームを直立へ
  bash "$HERE/reset_block.sh"                # ブロックを開始位置へ
  python3 "$HERE/goto_upright.py" 2          # 物理が落ち着くまで保持

  : > /tmp/infer.log
  nohup bash "$HERE/push-infer" > /tmp/infer.log 2>&1 &
  # 方策が最初の指令を出すまで待つ（最大90秒）
  for _ in $(seq 1 180); do
    grep -q '^action:' /tmp/infer.log && break
    sleep 0.5
  done
  sleep "$SEC"
  pkill -f "scripts/infer.py" >/dev/null 2>&1 || true
  sleep 2

  XY=$(bash "$HERE/block_pose.sh")
  RES=$(python3 -c "
import sys
v = sys.argv[1].strip().strip('[]').split()
x, y = float(v[0]), float(v[1])
d = ((x-0.1289)**2 + (y-0.0547)**2) ** 0.5
print(f'{x:+.4f} {y:+.4f} {d*100:.2f} {1 if d < 0.04 else 0}')
" "$XY")
  set -- $RES
  echo "trial $i: block=($1,$2)  goal_dist=$3 cm  $([ "$4" = 1 ] && echo OK || echo MISS)"
  OK=$((OK + $4))
  SUM=$(python3 -c "print($SUM + $3)")
done
python3 -c "print(f'成功 $OK/$N   平均誤差 {$SUM/$N:.2f} cm')"
